<Window x:Class="ExternalProgram.DrawingTemplateSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="模板设置"
        Width="640"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="按图幅设置工程图模板与图纸格式"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                   Text="模板为 .drwdot 文件，图纸格式为 .slddrt 文件。批量生成时按所选图幅自动套用。"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- 表头 -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="图幅" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="模板 (.drwdot)" FontWeight="SemiBold" Margin="8,0,0,0" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="图纸格式 (.slddrt)" FontWeight="SemiBold" Margin="16,0,0,0" />
            <!-- 行由代码动态生成并追加 -->
            <ItemsControl x:Name="RowsHost"
                          Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="5"
                          Margin="0,8,0,0" />
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <ui:Button Content="取消"
                       MinWidth="96"
                       Height="34"
                       Margin="0,0,8,0"
                       Click="Cancel_Click" />
            <ui:Button Content="确定"
                       Appearance="Primary"
                       MinWidth="96"
                       Height="34"
                       Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
