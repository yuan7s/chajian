<Window x:Class="ExternalProgram.DrawingBatchFileFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="选择要生成工程图的文件"
        Width="760"
        Height="560"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PanelBrush" Color="#FCFCFD" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE3EA" />

            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="ActionButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="PrimaryActionButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style TargetType="{x:Type TextBox}">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="9,4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="{x:Type CheckBox}"
                   BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Margin" Value="0,0,18,0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="16" FontWeight="SemiBold">
                <Run Text="筛选到 " />
                <Run x:Name="TotalCountText" Text="0" />
                <Run Text=" 个，已勾选 " />
                <Run x:Name="SelectedCountText" Text="0" />
                <Run Text=" 个" />
            </TextBlock>
        </StackPanel>

        <!-- Filters card -->
        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}">
            <StackPanel>
                <!-- Row 1: Type filter + batch actions -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="FilterPartCheck"
                                  Content="零件 (.sldprt)"
                                  IsChecked="True"
                                  Checked="Filter_Changed"
                                  Unchecked="Filter_Changed" />
                        <CheckBox x:Name="FilterAssemblyCheck"
                                  Content="装配体 (.sldasm)"
                                  IsChecked="True"
                                  Checked="Filter_Changed"
                                  Unchecked="Filter_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button Content="全选"
                                   Width="64"
                                   Height="30"
                                   Click="SelectAll_Click" />
                        <ui:Button Content="反选"
                                   Width="64"
                                   Height="30"
                                   Margin="8,0,0,0"
                                   Click="InvertSelection_Click" />
                    </StackPanel>
                </Grid>

                <!-- Row 2: Filename filter -->
                <TextBlock Text="文件名筛选" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="NameFilterBox"
                         Margin="0,0,0,8"
                         TextChanged="NameFilter_TextChanged" />

                <!-- Row 3: Path / property keyword filter -->
                <TextBlock Text="路径/属性关键词筛选" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="PropertyFilterBox"
                         TextChanged="PropertyFilter_TextChanged" />
            </StackPanel>
        </Border>

        <!-- File list -->
        <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}">
            <ListView x:Name="FileList"
                      BorderBrush="{StaticResource PanelBorderBrush}"
                      BorderThickness="1"
                      Background="#F7FAFC"
                      SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header=""
                                        Width="36">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="文件名"
                                        Width="220"
                                        DisplayMemberBinding="{Binding FileName}" />
                        <GridViewColumn Header="类型"
                                        Width="70"
                                        DisplayMemberBinding="{Binding DocType}" />
                        <GridViewColumn Header="路径"
                                        Width="320"
                                        DisplayMemberBinding="{Binding FullPath}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <ui:Button Content="取消"
                       MinWidth="96"
                       Height="34"
                       Margin="0,0,8,0"
                       Click="Cancel_Click" />
            <ui:Button Content="确定"
                       Appearance="Primary"
                       MinWidth="96"
                       Height="34"
                       Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
