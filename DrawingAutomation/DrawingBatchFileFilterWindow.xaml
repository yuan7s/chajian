<Window x:Class="ExternalProgram.DrawingBatchFileFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="选择要生成工程图的文件"
        Width="760"
        Height="560"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PanelBrush" Color="#FCFCFD" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE3EA" />

            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="ActionButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="PrimaryActionButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style TargetType="{x:Type TextBox}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="{x:Type CheckBox}"
                   BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16" LastChildFill="True">

        <!-- Header + Filters -->
        <Border DockPanel.Dock="Top" Style="{StaticResource SectionCardStyle}">
            <StackPanel>
                <!-- Count header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock FontSize="15" FontWeight="SemiBold">
                        <Run Text="筛选到 " />
                        <Run x:Name="TotalCountText" Text="0" />
                        <Run Text=" 个，已勾选 " />
                        <Run x:Name="SelectedCountText" Text="0" />
                        <Run Text=" 个" />
                    </TextBlock>
                </StackPanel>

                <!-- Type filter + select actions -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="FilterPartCheck"
                                  Content="零件 (.sldprt)"
                                  IsChecked="True"
                                  Checked="Filter_Changed"
                                  Unchecked="Filter_Changed" />
                        <CheckBox x:Name="FilterAssemblyCheck"
                                  Content="装配体 (.sldasm)"
                                  IsChecked="True"
                                  Checked="Filter_Changed"
                                  Unchecked="Filter_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button Content="全选" Width="56" Height="28"
                                   Click="SelectAll_Click" />
                        <ui:Button Content="反选" Width="56" Height="28"
                                   Margin="6,0,0,0"
                                   Click="InvertSelection_Click" />
                    </StackPanel>
                </Grid>

                <!-- Filename + Keyword filters in one row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="文件名筛选" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="NameFilterBox"
                                 TextChanged="NameFilter_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="路径/关键词筛选" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="PropertyFilterBox"
                                 TextChanged="PropertyFilter_TextChanged" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom buttons — docked first so they always get space -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <ui:Button Content="取消" MinWidth="96" Height="34"
                       Margin="0,0,8,0"
                       Click="Cancel_Click" />
            <ui:Button Content="确定" MinWidth="96" Height="34"
                       Appearance="Primary"
                       Click="Ok_Click" />
        </StackPanel>

        <!-- File list — last child, fills remaining space -->
        <Border Padding="14,12" Margin="0,0,0,0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1">
            <ListView x:Name="FileList"
                      BorderBrush="{StaticResource PanelBorderBrush}"
                      BorderThickness="1"
                      Background="#F7FAFC"
                      SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="ToolTip" Value="{Binding FullPath}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="36">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="文件名" Width="220"
                                        DisplayMemberBinding="{Binding FileName}" />
                        <GridViewColumn Header="类型" Width="70"
                                        DisplayMemberBinding="{Binding DocType}" />
                        <GridViewColumn Header="路径" Width="300"
                                        DisplayMemberBinding="{Binding FullPath}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
