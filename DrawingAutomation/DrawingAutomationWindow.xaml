  <Window x:Class="ExternalProgram.DrawingAutomationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="工程图"
        Width="760"
        Height="650"
        MinWidth="720"
        MinHeight="630"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PanelBrush" Color="#FCFCFD" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE3EA" />

            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="ActionButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="PrimaryActionButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style TargetType="{x:Type TextBox}">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="9,4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="{x:Type CheckBox}"
                   BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Margin" Value="0,0,18,8" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="工程图"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ActiveDocumentText"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ui:Button Grid.Column="1"
                       Content="刷新"
                       Style="{StaticResource ActionButtonStyle}"
                       Click="RefreshButton_Click" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="图纸" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="工程图模板" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TemplatePathBox" Grid.Column="0" />
                        <ui:Button Grid.Column="2"
                                   Content="选择"
                                   Width="62"
                                   Style="{StaticResource ActionButtonStyle}"
                                   Click="BrowseTemplate_Click" />
                    </Grid>

                    <TextBlock Text="绘图标准文件" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="StandardPathBox" Grid.Column="0" />
                        <ui:Button Grid.Column="2"
                                   Content="选择"
                                   Width="62"
                                   Style="{StaticResource ActionButtonStyle}"
                                   Click="BrowseStandard_Click" />
                    </Grid>

                    <TextBlock Text="图纸格式文件" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SheetFormatPathBox" Grid.Column="0" />
                        <ui:Button Grid.Column="2"
                                   Content="选择"
                                   Width="62"
                                   Style="{StaticResource ActionButtonStyle}"
                                   Click="BrowseSheetFormat_Click" />
                    </Grid>

                    <WrapPanel>
                        <CheckBox x:Name="UseDefaultTemplateCheck"
                                  Content="使用 SW 默认模板"
                                  Checked="TemplateMode_Changed"
                                  Unchecked="TemplateMode_Changed" />
                        <CheckBox x:Name="SaveDrawingCheck" Content="保存到模型同目录" />
                        <CheckBox x:Name="OverwriteDrawingCheck" Content="允许覆盖" />
                    </WrapPanel>
                    <WrapPanel>
                        <CheckBox x:Name="ApplySettingsCheck" Content="套用绘图标准/图纸格式" />
                        <CheckBox x:Name="InsertViewsCheck" Content="生成三视图" />
                        <CheckBox x:Name="InsertIsoViewCheck" Content="等轴测" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="模型项目" Style="{StaticResource SectionTitleStyle}" />
                    <WrapPanel>
                        <CheckBox x:Name="ImportModelItemsCheck" Content="导入模型项目" />
                        <CheckBox x:Name="DuplicateDimsCheck" Content="允许重复尺寸" />
                        <CheckBox x:Name="HiddenFeatureDimsCheck" Content="隐藏特征尺寸" />
                    </WrapPanel>
                    <WrapPanel>
                        <CheckBox x:Name="UseSketchPlacementCheck" Content="使用草图位置" />
                        <CheckBox x:Name="AutoArrangeCheck" Content="自动排列尺寸" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SummaryText"
                               Grid.Row="0"
                               Text="等待执行"
                               Style="{StaticResource SectionTitleStyle}" />
                    <ListView x:Name="ResultList"
                              Grid.Row="1"
                              MinHeight="230"
                              BorderBrush="{StaticResource PanelBorderBrush}"
                              BorderThickness="1"
                              Background="#F7FAFC">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="等级"
                                                Width="74"
                                                DisplayMemberBinding="{Binding Severity}" />
                                <GridViewColumn Header="项目"
                                                Width="128"
                                                DisplayMemberBinding="{Binding Item}" />
                                <GridViewColumn Header="内容"
                                                Width="310"
                                                DisplayMemberBinding="{Binding Message}" />
                                <GridViewColumn Header="详情"
                                                Width="180"
                                                DisplayMemberBinding="{Binding Detail}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="1"
                       x:Name="CheckButton"
                       Content="检查遗漏"
                       Style="{StaticResource ActionButtonStyle}"
                       Click="CheckButton_Click" />
            <ui:Button Grid.Column="3"
                       x:Name="HoleCalloutButton"
                       Content="孔标注"
                       Style="{StaticResource ActionButtonStyle}"
                       Click="HoleCalloutButton_Click" />
            <ui:Button Grid.Column="5"
                       x:Name="ImportButton"
                       Content="导入模型项目"
                       Style="{StaticResource ActionButtonStyle}"
                       Click="ImportButton_Click" />
            <ui:Button Grid.Column="7"
                       x:Name="GenerateButton"
                       Content="生成标准工程图"
                       Style="{StaticResource PrimaryActionButtonStyle}"
                       Click="GenerateButton_Click" />
        </Grid>
    </Grid>
</Window>
