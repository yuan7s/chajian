<ui:FluentWindow x:Class="外部程序.DrawingSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="绘图标准设置"
                 Width="650"
                 Height="260"
                 MinWidth="590"
                 MinHeight="240"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Microsoft YaHei UI"
                 FontSize="13"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PanelBrush" Color="#FCFCFD" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE3EA" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="绘图标准设置"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="配置工程图标准文件和图纸格式模板。"
                       Margin="0,4,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="16,14"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="绘图标准"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBox x:Name="DrawingStandardBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Height="34"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center" />
                <ui:Button Grid.Row="0"
                           Grid.Column="2"
                           Content="文件选择"
                           Appearance="Secondary"
                           Height="34"
                           Click="SelectDrawingStandard_Click" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="图纸格式"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBox x:Name="SheetFormatBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Height="34"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center" />
                <ui:Button Grid.Row="2"
                           Grid.Column="2"
                           Content="文件选择"
                           Appearance="Secondary"
                           Height="34"
                           Click="SelectSheetFormat_Click" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="全局快捷键: Ctrl+F1（显示/隐藏主窗口）"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,12,0,0" />
    </Grid>
</ui:FluentWindow>

