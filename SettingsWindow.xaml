<ui:FluentWindow x:Class="外部程序.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="程序设置"
                 Width="760"
                 Height="620"
                 MinWidth="720"
                 MinHeight="560"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Microsoft YaHei UI"
                 FontSize="13"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PanelBrush" Color="#FCFCFD" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE3EA" />

            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="HintTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>

            <Style TargetType="{x:Type CheckBox}"
                   BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SettingsButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="MinWidth" Value="86" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="PrimarySettingsButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource SettingsButtonStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SmallSettingsButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="ToolbarDropListStyle" TargetType="{x:Type ListBox}">
                <Setter Property="MinHeight" Value="116" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Background" Value="#F7FAFC" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="ToolbarButtonItemTemplate">
                <Border Padding="10,7"
                        Background="White"
                        BorderBrush="#D8E2EC"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Text="{Binding Text}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Margin="18"
          Background="Transparent"
          MouseLeftButtonDown="WindowDragArea_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="程序设置"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="设置会保存到用户配置，并在主工具栏、属性悬浮窗和后续命令中生效。"
                       Margin="0,4,0,0"
                       Style="{StaticResource HintTextStyle}" />
        </StackPanel>

        <TabControl x:Name="SettingsTabs" Grid.Row="1">
            <TabItem Header="按钮显示">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,12,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="按钮池" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="从这里拖到右侧分组。拖回按钮池可从分组移除。"
                                               Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                                <ListBox x:Name="ToolbarPoolList"
                                         Tag="Pool"
                                         Style="{StaticResource ToolbarDropListStyle}"
                                         ItemTemplate="{StaticResource ToolbarButtonItemTemplate}"
                                         AllowDrop="True"
                                         PreviewMouseLeftButtonDown="ToolbarList_PreviewMouseLeftButtonDown"
                                         MouseMove="ToolbarList_MouseMove"
                                         DragOver="ToolbarList_DragOver"
                                         Drop="ToolbarList_Drop" />
                            </DockPanel>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" Text="零件" Style="{StaticResource SectionTitleStyle}" />
                                    <ListBox x:Name="ToolbarPartList"
                                             Tag="Part"
                                             Style="{StaticResource ToolbarDropListStyle}"
                                             ItemTemplate="{StaticResource ToolbarButtonItemTemplate}"
                                             AllowDrop="True"
                                             PreviewMouseLeftButtonDown="ToolbarList_PreviewMouseLeftButtonDown"
                                             MouseMove="ToolbarList_MouseMove"
                                             DragOver="ToolbarList_DragOver"
                                             Drop="ToolbarList_Drop" />
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" Text="工程图" Style="{StaticResource SectionTitleStyle}" />
                                    <ListBox x:Name="ToolbarDrawingList"
                                             Tag="Drawing"
                                             Style="{StaticResource ToolbarDropListStyle}"
                                             ItemTemplate="{StaticResource ToolbarButtonItemTemplate}"
                                             AllowDrop="True"
                                             PreviewMouseLeftButtonDown="ToolbarList_PreviewMouseLeftButtonDown"
                                             MouseMove="ToolbarList_MouseMove"
                                             DragOver="ToolbarList_DragOver"
                                             Drop="ToolbarList_Drop" />
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource SectionCardStyle}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" Text="装配体" Style="{StaticResource SectionTitleStyle}" />
                                    <ListBox x:Name="ToolbarAssemblyList"
                                             Tag="Assembly"
                                             Style="{StaticResource ToolbarDropListStyle}"
                                             ItemTemplate="{StaticResource ToolbarButtonItemTemplate}"
                                             AllowDrop="True"
                                             PreviewMouseLeftButtonDown="ToolbarList_PreviewMouseLeftButtonDown"
                                             MouseMove="ToolbarList_MouseMove"
                                             DragOver="ToolbarList_DragOver"
                                             Drop="ToolbarList_Drop" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="属性悬浮窗">
                <Grid Margin="0,12,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="窗口外观与交互" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="OverlayOpacityLabel" Style="{StaticResource FieldLabelStyle}" />
                                <Slider x:Name="OverlayOpacitySlider"
                                        Minimum="15"
                                        Maximum="100"
                                        TickFrequency="5"
                                        Margin="0,0,0,14" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="颜色方案" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="OverlayColorCombo" Height="32">
                                            <ComboBoxItem Content="自适应" />
                                            <ComboBoxItem Content="终端绿" />
                                            <ComboBoxItem Content="白字" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="显示范围" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="OverlayDisplayModeCombo" Height="32">
                                            <ComboBoxItem Content="关键属性" />
                                            <ComboBoxItem Content="全部属性" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="属性来源" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="OverlayPropSourceCombo" Height="32">
                                            <ComboBoxItem Content="配置属性" />
                                            <ComboBoxItem Content="自定义属性" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <CheckBox x:Name="OverlayTopMostCheck" Content="始终置顶" Margin="0,0,0,8" />
                                        <CheckBox x:Name="OverlayMouseThroughCheck" Content="鼠标穿透" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="鼠标穿透仍可用 Ctrl+F2 在悬浮窗打开时快速切换。"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="4,0,4,0" />
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="2"
                                       Text="关键属性"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <ListBox x:Name="OverlayKeyList"
                                     Grid.Row="1"
                                     Grid.Column="0"
                                     MinHeight="310"
                                     BorderBrush="{StaticResource PanelBorderBrush}"
                                     Background="White" />

                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                <ui:Button Content="上移"
                                           Style="{StaticResource SmallSettingsButtonStyle}"
                                           Click="OverlayKeyUpButton_Click" />
                                <ui:Button Content="下移"
                                           Style="{StaticResource SmallSettingsButtonStyle}"
                                           Margin="0,8,0,0"
                                           Click="OverlayKeyDownButton_Click" />
                            </StackPanel>

                            <Grid Grid.Row="2"
                                  Grid.ColumnSpan="2"
                                  Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="OverlayNewKeyText"
                                         Grid.Column="0"
                                         Height="32"
                                         VerticalContentAlignment="Center" />
                                <ui:Button Grid.Column="2"
                                           Content="添加"
                                           Style="{StaticResource SettingsButtonStyle}"
                                           Click="OverlayKeyAddButton_Click" />
                                <ui:Button Grid.Column="4"
                                           Content="删除"
                                           Style="{StaticResource SettingsButtonStyle}"
                                           Click="OverlayKeyDeleteButton_Click" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="重命名">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="写入位置" Style="{StaticResource SectionTitleStyle}" />
                                        <ComboBox x:Name="RenamePropertyTargetCombo"
                                                  Height="32">
                                            <ComboBoxItem Content="配置属性" Tag="configuration" />
                                            <ComboBoxItem Content="自定义属性" Tag="custom" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="附加操作" Style="{StaticResource SectionTitleStyle}" />
                                        <CheckBox x:Name="RenameBlankSizeCheck" Content="下料尺寸" Margin="0,0,0,12" />
                                        <CheckBox x:Name="RenameNamePropertiesCheck" Content="图号/编码/文件名称" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.ColumnSpan="2"
                                           Text="额外写入属性"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="列表中的属性会随重命名写入；可以添加属性名并填写默认值。"
                                           Style="{StaticResource HintTextStyle}"
                                           Margin="0,0,0,10" />

                                <Grid Grid.Row="2" Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="属性名" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Grid.Column="1" Text="默认值" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,5" />
                                    </Grid>
                                    <ListBox x:Name="RenamePropertyList"
                                             Grid.Row="1"
                                             MinHeight="150"
                                             BorderBrush="{StaticResource PanelBorderBrush}"
                                             Background="White">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="1.2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Height="28"
                                                             VerticalContentAlignment="Center"
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox Grid.Column="1"
                                                             Height="28"
                                                             Margin="8,0,0,0"
                                                             VerticalContentAlignment="Center"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <StackPanel Grid.Row="2"
                                            Grid.Column="1"
                                            Margin="6,24,0,0"
                                            VerticalAlignment="Center">
                                    <ui:Button Content="上移"
                                               Style="{StaticResource SmallSettingsButtonStyle}"
                                               Click="RenamePropertyUpButton_Click" />
                                    <ui:Button Content="下移"
                                               Style="{StaticResource SmallSettingsButtonStyle}"
                                               Margin="0,8,0,0"
                                               Click="RenamePropertyDownButton_Click" />
                                    <ui:Button Content="删除"
                                               Style="{StaticResource SmallSettingsButtonStyle}"
                                               Margin="0,8,0,0"
                                               Click="RenamePropertyDeleteButton_Click" />
                                </StackPanel>

                                <Grid Grid.Row="3"
                                      Grid.ColumnSpan="2"
                                      Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RenameNewPropertyNameText"
                                             Height="32"
                                             VerticalContentAlignment="Center" />
                                    <TextBox x:Name="RenameNewPropertyValueText"
                                             Grid.Column="1"
                                             Height="32"
                                             Margin="8,0,0,0"
                                             VerticalContentAlignment="Center" />
                                    <ui:Button Grid.Column="3"
                                               Content="添加"
                                               Style="{StaticResource SettingsButtonStyle}"
                                               Click="RenamePropertyAddButton_Click" />
                                </Grid>
                            </Grid>
                        </Border>
                        </Grid>

                        <TextBlock Text="这些值作为新打开重命名窗口的默认参数；单次窗口内仍可临时调整。"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="4,0,4,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="排序逻辑">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,10,0">
                        <Border Style="{StaticResource SectionCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="名称依据" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="SortNameSourceCombo" Height="32" Margin="0,0,0,14">
                                        <ComboBoxItem Content="组件名" Tag="ComponentName" />
                                        <ComboBoxItem Content="文件名" Tag="FileName" />
                                    </ComboBox>

                                    <TextBlock Text="方向" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="SortDirectionCombo" Height="32">
                                        <ComboBoxItem Content="升序" Tag="Ascending" />
                                        <ComboBoxItem Content="降序" Tag="Descending" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <CheckBox x:Name="SortAssemblyFirstCheck"
                                              Content="装配体排在零件前"
                                              Margin="0,0,0,10" />
                                    <CheckBox x:Name="SortSuppressedLastCheck"
                                              Content="压缩/包络组件放最后"
                                              Margin="0,0,0,10" />
                                    <CheckBox x:Name="SortFoldersCheck"
                                              Content="排序文件夹内组件"
                                              Margin="0,0,0,10" />
                                    <CheckBox x:Name="SortRecursiveCheck"
                                              Content="递归排序子装配体" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="排序按钮会把这里的参数发送给 SolidWorks 插件端；未勾选“排序文件夹内组件”时只处理顶层非文件夹组件。"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="4,0,4,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SaveStatusText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ui:Button Grid.Column="1"
                       Content="应用"
                       Style="{StaticResource SettingsButtonStyle}"
                       Click="ApplyButton_Click" />
            <ui:Button Grid.Column="3"
                       Content="保存并关闭"
                       Style="{StaticResource PrimarySettingsButtonStyle}"
                       Click="SaveAndCloseButton_Click" />
            <ui:Button Grid.Column="5"
                       Content="关闭"
                       Style="{StaticResource SettingsButtonStyle}"
                       Click="CloseButton_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>
