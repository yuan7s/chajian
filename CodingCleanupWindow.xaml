<Window x:Class="ExternalProgram.CodingCleanupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="编码整理"
                 Width="360"
                 Height="450"
                 MinWidth="360"
                 MinHeight="350"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Microsoft YaHei UI"
                 FontSize="13"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PanelBrush" Color="#FCFCFD" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE3EA" />

            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="ActionButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>



        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="名称筛选（可选）" />
                <TextBox x:Name="NameFilterBox"
                         Height="34"
                         VerticalContentAlignment="Center"
                         LostFocus="NameFilterBox_LostFocus"
                         KeyDown="NameFilterBox_KeyDown" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="处理范围" />
                <WrapPanel Margin="0,0,0,14">
                    <CheckBox x:Name="ProcessAsmCheck"
                              Content="处理装配体"
                              Margin="0,0,22,0"
                              Checked="SettingCheck_Changed"
                              Unchecked="SettingCheck_Changed" />
                    <CheckBox x:Name="ProcessPartCheck"
                              Content="处理零件"
                              Checked="SettingCheck_Changed"
                              Unchecked="SettingCheck_Changed" />
                </WrapPanel>

                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="排除条件" />
                <CheckBox x:Name="ExcludeVirtualCheck"
                          Content="排除虚拟装配体"
                          Margin="0,0,0,8"
                          Checked="SettingCheck_Changed"
                          Unchecked="SettingCheck_Changed" />
                <CheckBox x:Name="ExcludeStandardCheck"
                          Content="排除标准件"
                          Margin="0,0,0,8"
                          Checked="SettingCheck_Changed"
                          Unchecked="SettingCheck_Changed" />
                <CheckBox x:Name="ExcludePurchasedCheck"
                          Content="排除外购件"
                          Checked="SettingCheck_Changed"
                          Unchecked="SettingCheck_Changed" />
            </StackPanel>
        </Border>

        <ui:Button Grid.Row="3"
                   x:Name="ExecuteButton"
                   Content="执行编码整理"
                   Style="{StaticResource ActionButtonStyle}"
                   Width="160"
                   Height="36"
                   HorizontalAlignment="Right"
                   Click="ExecuteButton_Click" />
    </Grid>
</Window>
