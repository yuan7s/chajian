<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ExternalProgram</RootNamespace>
    <AssemblyName>ExternalProgram</AssemblyName>
    <StartupObject>ExternalProgram.Program</StartupObject>
    <ApplicationIcon>Properties\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebugType>none</DebugType>
    <NoWarn>41999,42016,42017,42018,42019,42032,42036,CA1416,CS4014,CS1998</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);ReadBom\**</DefaultItemExcludes>
    <BuildSwAddinDuringMainBuild>false</BuildSwAddinDuringMainBuild>
    <SwAddinProject>$(MSBuildThisFileDirectory)ExternalProgram.SwAddin\ExternalProgram.SwAddin.csproj</SwAddinProject>
    <SwAddinOutputDirectory>$(MSBuildThisFileDirectory)ExternalProgram.SwAddin\bin\$(Configuration)\net48\</SwAddinOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Properties\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ExternalProgram.SwAddin\**\*.cs" />
    <Compile Remove="ExternalProgram.SwAddin.Runtime\**\*.cs" />
    <Compile Remove="ExternalProgram.Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <Target Name="BuildSwAddin" BeforeTargets="Build;Publish" Condition="'$(BuildSwAddinDuringMainBuild)' == 'true'">
    <MSBuild Projects="$(SwAddinProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="OutDir;OutputPath;PublishDir" />
  </Target>

  <Target Name="CopySwAddinToPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <SwAddinPublishFile Include="$(SwAddinOutputDirectory)ExternalProgram.SwAddin.dll" />
      <SwAddinPublishFile Include="$(SwAddinOutputDirectory)Interop.SldWorks.dll" />
      <SwAddinPublishFile Include="$(SwAddinOutputDirectory)Interop.SwConst.dll" />
      <SwAddinPublishFile Include="$(SwAddinOutputDirectory)SolidWorks.Interop.swpublished.dll" />
      <SwAddinPublishFile Include="$(SwAddinOutputDirectory)SolidWorks.Interop.swdocumentmgr.dll" />
      <SwAddinPublishFile Include="$(SwAddinOutputDirectory)SolidWorksTools.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SwAddinPublishFile)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(SwAddinPublishFile.FullPath)')" />
  </Target>

  <Target Name="CopySwAddinToOutput" AfterTargets="Build">
    <ItemGroup>
      <SwAddinPackageFile Include="$(SwAddinOutputDirectory)ExternalProgram.SwAddin.dll" />
      <SwAddinPackageFile Include="$(SwAddinOutputDirectory)Interop.SldWorks.dll" />
      <SwAddinPackageFile Include="$(SwAddinOutputDirectory)Interop.SwConst.dll" />
      <SwAddinPackageFile Include="$(SwAddinOutputDirectory)SolidWorks.Interop.swpublished.dll" />
      <SwAddinPackageFile Include="$(SwAddinOutputDirectory)SolidWorks.Interop.swdocumentmgr.dll" />
      <SwAddinPackageFile Include="$(SwAddinOutputDirectory)SolidWorksTools.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SwAddinPackageFile)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(SwAddinPackageFile.FullPath)')" />
  </Target>

</Project>

