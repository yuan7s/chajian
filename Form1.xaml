<Window x:Class="Form1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外部程序"
        Width="594"
        Height="368"
        MinWidth="594"
        MinHeight="326"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Microsoft YaHei"
        Loaded="Form1_Load"
        SourceInitialized="Form1_SourceInitialized"
        Closing="Form1_Closing"
        Closed="Form1_Closed">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Bottom"
                Margin="0,10,0,0"
                Padding="10,8"
                Background="#F8FAFC"
                BorderBrush="#D7DEE8"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="214" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="RefreshBtn"
                        Content="↻"
                        Width="34"
                        Height="30"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        ToolTip="刷新进程"
                        Click="RefreshBtn_Click" />

                <ComboBox x:Name="swProcessCombo"
                          Grid.Column="1"
                          Height="30"
                          Margin="8,0,0,0"
                          Padding="6,2"
                          VerticalContentAlignment="Center"
                          Background="White"
                          BorderBrush="#CBD5E1"
                          BorderThickness="1"
                          SelectionChanged="swProcessCombo_SelectedIndexChanged" />

                <Border Grid.Column="2"
                        Width="1"
                        Margin="7,2"
                        Background="#D7DEE8" />

                <TextBlock x:Name="filePrefixLabel"
                           Grid.Column="3"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#64748B"
                           Text="当前文件" />

                <Border Grid.Column="4"
                        Padding="8,4"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock x:Name="fileNameLabel"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#0F172A"
                               Text="未连接"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="GroupBox1"
                      Header="文件"
                      Grid.Row="0"
                      Grid.Column="0"
                      Padding="10"
                      Margin="0,0,0,10">
                <UniformGrid Columns="3" Rows="1">
                    <Button x:Name="Button9" Content="图号编码" Margin="4" Height="32" Click="Button9_Click" />
                    <Button x:Name="Button5" Content="ISO 标准" Margin="4" Height="32" Click="Button5_Click" />
                    <Button x:Name="Button2" Content="打开目录" Margin="4" Height="32" Click="Button2_Click" />
                </UniformGrid>
            </GroupBox>

            <GroupBox x:Name="GroupBox3"
                      Header="工程图"
                      Grid.Row="0"
                      Grid.Column="2"
                      Padding="10"
                      Margin="0,0,0,10">
                <UniformGrid Columns="3" Rows="1">
                    <Button x:Name="Button1" Content="另存 DWG" Margin="4" Height="32" Click="Button1_Click" />
                    <Button x:Name="Button8" Content="另存 PDF" Margin="4" Height="32" Click="Button8_Click" />
                    <Button x:Name="Button4" Content="旋转视图" Margin="4" Height="32" Click="Button4_Click" />
                </UniformGrid>
            </GroupBox>

            <GroupBox x:Name="GroupBox2"
                      Header="装配体"
                      Grid.Row="1"
                      Grid.ColumnSpan="3"
                      Padding="10"
                      Margin="0,0,0,10">
                <UniformGrid Columns="6" Rows="1">
                    <Button x:Name="Button6" Content="删除自定义属性" Margin="4" Height="32" Click="Button6_Click_1" />
                    <Button x:Name="Button17" Content="删除配置属性" Margin="4" Height="32" Click="Button17_Click" />
                    <Button x:Name="Button18" Content="编码整理" Margin="4" Height="32" Click="Button18_Click" />
                    <Button x:Name="Button16" Content="重命名" Margin="4" Height="32" Click="Button16_Click" />
                    <Button x:Name="Button13" Content="排序装配体" Margin="4" Height="32" Click="Button13_Click" />
                    <Button x:Name="Button11" Content="特征树设置" Margin="4" Height="32" Click="Button11_Click" />
                </UniformGrid>
            </GroupBox>

            <StackPanel Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <GroupBox Header="配置属性" Margin="10,0,4,0" Padding="4,0,4,4">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="Button19" Content="打开" Margin="3" Width="62" Height="28" Click="Button19_Click" />
                        <Button x:Name="Button20" Content="设置" Margin="3" Width="62" Height="28" Click="Button20_Click" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="窗口" Margin="8,0,0,0" Padding="4,0,4,4">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="Button10" Content="关闭SW" Margin="3" Width="72" Height="28" Click="Button10_Click" />
                        <Button x:Name="Button12" Content="置顶" Margin="3" Width="62" Height="28" Click="Button12_Click" />
                    </StackPanel>
                </GroupBox>

                <Button x:Name="Button14"
                        Content="设置"
                        Margin="8,10,0,4"
                        Width="62"
                        Height="28"
                        VerticalAlignment="Center"
                        Click="Button14_Click_1" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
