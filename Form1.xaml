<ui:FluentWindow x:Class="ExternalProgram.Form1"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="External Program"
                 Icon="Properties/AppIcon.ico"
                 Width="510"
                 Height="45"
                 MinWidth="500"
                 MinHeight="55"
                 MaxWidth="920"
                 MaxHeight="92"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 Topmost="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Microsoft YaHei UI"
                 FontSize="12"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 Loaded="Form1_Load"
                 SourceInitialized="Form1_SourceInitialized"
                 Closing="Form1_Closing"
                 Closed="Form1_Closed">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="ToolbarShellBrush" Color="#F3F6FA" />
            <SolidColorBrush x:Key="ToolbarGroupBrush" Color="#FCFCFD" />
            <SolidColorBrush x:Key="ToolbarGroupBorderBrush" Color="#DCE3EA" />
            <SolidColorBrush x:Key="ConnectionOnlineBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="ConnectionOfflineBrush" Color="#DC2626" />

            <Style x:Key="ConnectionSelectorButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Width" Value="98" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ToolbarButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="60" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ToolbarWideButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="MinWidth" Value="65" />
            </Style>

            <Style x:Key="ToolbarPrimaryButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource ToolbarWideButtonStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="ToolbarDangerButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource ToolbarWideButtonStyle}">
                <Setter Property="Appearance" Value="Danger" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Margin="5" MouseLeftButtonDown="WindowDragArea_MouseLeftButtonDown">
        <Border Padding="5"
                Background="{StaticResource ToolbarShellBrush}"
                BorderBrush="{StaticResource ToolbarGroupBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <ScrollViewer Height="30"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ToolbarPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:Button x:Name="ConnectionSelectorButton"
                               Style="{StaticResource ConnectionSelectorButtonStyle}"
                               Click="ConnectionSelectorButton_Click"
                               ToolTip="未连接"
                               VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ConnectionStatusIcon"
                                     Width="10"
                                     Height="10"
                                     Margin="0,0,6,0"
                                     ToolTip="未连接">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource ConnectionOfflineBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="ToolTip" Value="已连接">
                                                <Setter Property="Fill" Value="{StaticResource ConnectionOnlineBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock x:Name="FileNameLabel"
                                       Width="54"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Text="未连接"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="ConnectionDropGlyph"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="▾"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:Button>

                    <Border Width="1"
                            Height="20"
                            Margin="9,0,11,0"
                            Background="{StaticResource ToolbarGroupBorderBrush}"
                            VerticalAlignment="Center" />

                    <StackPanel x:Name="CommonActionsPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <ui:Button x:Name="Button2" Content="打开目录" Style="{StaticResource ToolbarWideButtonStyle}" Click="Button2_Click" Visibility="Collapsed" ToolTip="打开当前文档或选中组件所在的文件夹" />
                        <ui:Button x:Name="Button9" Content="图号编码" Style="{StaticResource ToolbarWideButtonStyle}" Click="Button9_Click" Visibility="Collapsed" ToolTip="将文件名同步写入物料编码、零件图号和文件名称属性" />
                        <ui:Button x:Name="Button16" Content="重命名" Style="{StaticResource ToolbarButtonStyle}" Click="Button16_Click" Visibility="Collapsed" ToolTip="打开重命名窗口，支持另存、重命名和属性写入" />
                    </StackPanel>

                    <StackPanel x:Name="DrawingActionsPanel"
                                Orientation="Horizontal"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:Button x:Name="Button1" Content="另存 DWG" Style="{StaticResource ToolbarPrimaryButtonStyle}" Click="Button1_Click" ToolTip="将当前工程图另存为同名 DWG 文件" />
                        <ui:Button x:Name="Button8" Content="另存 PDF" Style="{StaticResource ToolbarPrimaryButtonStyle}" Click="Button8_Click" ToolTip="将当前工程图另存为同名 PDF 文件" />
                        <ui:Button x:Name="Button4" Content="旋转视图" Style="{StaticResource ToolbarWideButtonStyle}" Click="Button4_Click" ToolTip="将选中的工程图视图旋转 90 度" />
                        <ui:Button x:Name="Button5" Content="ISO" Style="{StaticResource ToolbarButtonStyle}" Click="Button5_Click" ToolTip="把当前工程图的标注标准设置为 ISO" />
                        <ui:Button x:Name="Button23" Content="标准格式" Style="{StaticResource ToolbarWideButtonStyle}" Click="Button23_Click" Visibility="Collapsed" ToolTip="按设置中的绘图标准和图纸格式替换当前工程图，并先删除工程图图层" />
                    </StackPanel>

                    <StackPanel x:Name="AssemblyActionsPanel"
                                Orientation="Horizontal"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:Button x:Name="Button18" Content="编码整理" Style="{StaticResource ToolbarPrimaryButtonStyle}" Click="Button18_Click" ToolTip="打开编码整理窗口，批量同步装配体子件编码属性" />
                        <ui:Button x:Name="Button20" Content="基准面配合" Style="{StaticResource ToolbarWideButtonStyle}" Click="Button20_Click" ToolTip="为选中组件添加与装配体前、上、右基准面的配合" />
                        <ui:Button x:Name="Button13" Content="排序" Style="{StaticResource ToolbarButtonStyle}" Click="Button13_Click" ToolTip="按设置规则排序装配体组件，可处理文件夹和子装配体" />
                        <ui:Button x:Name="Button11" Content="树设置" Style="{StaticResource ToolbarButtonStyle}" Click="Button11_Click" ToolTip="隐藏特征树中的配置名和显示状态名" />
                        <ui:Button x:Name="Button22" Content="运行宏" Style="{StaticResource ToolbarButtonStyle}" Click="Button22_Click" ToolTip="选择并运行 SolidWorks .swp 宏文件" />
                        <ui:Button x:Name="Button21" Content="删错配合" Style="{StaticResource ToolbarDangerButtonStyle}" Click="Button21_Click" ToolTip="删除当前装配体中存在错误的配合关系" />
                        <ui:Button x:Name="Button6" Content="删自定义" Style="{StaticResource ToolbarDangerButtonStyle}" Click="Button6_Click_1" ToolTip="删除当前装配体及其子件的自定义属性，执行前会确认" />
                        <ui:Button x:Name="Button17" Content="删配置" Style="{StaticResource ToolbarDangerButtonStyle}" Click="Button17_Click" ToolTip="删除当前装配体及其子件的配置属性，执行前会确认" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</ui:FluentWindow>
