<ui:FluentWindow x:Class="外部程序.Form1"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="外部程序"
                 Width="510"
                 Height="45"
                 MinWidth="500"
                 MinHeight="55"
                 MaxWidth="920"
                 MaxHeight="92"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 Topmost="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Microsoft YaHei UI"
                 FontSize="12"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 Loaded="Form1_Load"
                 SourceInitialized="Form1_SourceInitialized"
                 Closing="Form1_Closing"
                 Closed="Form1_Closed">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="ToolbarShellBrush" Color="#F3F6FA" />
            <SolidColorBrush x:Key="ToolbarGroupBrush" Color="#FCFCFD" />
            <SolidColorBrush x:Key="ToolbarGroupBorderBrush" Color="#DCE3EA" />
            <SolidColorBrush x:Key="ConnectionOnlineBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="ConnectionOfflineBrush" Color="#DC2626" />

            <Style x:Key="ToolbarButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="60" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ToolbarWideButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="MinWidth" Value="65" />
            </Style>

            <Style x:Key="ToolbarPrimaryButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource ToolbarWideButtonStyle}">
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="ToolbarDangerButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource ToolbarWideButtonStyle}">
                <Setter Property="Appearance" Value="Danger" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Margin="5" MouseLeftButtonDown="WindowDragArea_MouseLeftButtonDown">
        <Border Padding="5"
                Background="{StaticResource ToolbarShellBrush}"
                BorderBrush="{StaticResource ToolbarGroupBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <ScrollViewer Height="30"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Center">
                <StackPanel x:Name="ToolbarPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Padding="7,5"
                            Margin="0"
                            Background="{StaticResource ToolbarGroupBrush}"
                            BorderBrush="{StaticResource ToolbarGroupBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Width="75"
                            Height="26"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ConnectionStatusIcon"
                                     Width="10"
                                     Height="10"
                                     Margin="0,0,6,0"
                                     Fill="{StaticResource ConnectionOfflineBrush}"
                                     ToolTip="未连接" />
                            <TextBlock x:Name="fileNameLabel"
                                       Width="36"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Text="未连接"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Width="1"
                            Height="20"
                            Margin="9,0,11,0"
                            Background="{StaticResource ToolbarGroupBorderBrush}"
                            VerticalAlignment="Center" />

                    <StackPanel x:Name="CommonActionsPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <ui:Button x:Name="Button2" Content="打开目录" Style="{StaticResource ToolbarWideButtonStyle}" Click="Button2_Click" Visibility="Collapsed" />
                        <ui:Button x:Name="Button9" Content="同步属性" Style="{StaticResource ToolbarWideButtonStyle}" Click="Button9_Click" Visibility="Collapsed" />
                        <ui:Button x:Name="Button16" Content="重命名" Style="{StaticResource ToolbarButtonStyle}" Click="Button16_Click" Visibility="Collapsed" />
                        <ui:Button x:Name="Button19" Content="属性窗" Style="{StaticResource ToolbarButtonStyle}" Click="Button19_Click" Visibility="Collapsed" />
                        <ui:Button x:Name="Button20" Content="属性设置" Style="{StaticResource ToolbarWideButtonStyle}" Click="Button20_Click" MinWidth="65" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="DrawingActionsPanel"
                                Orientation="Horizontal"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:Button x:Name="Button1" Content="另存 DWG" Style="{StaticResource ToolbarPrimaryButtonStyle}" Click="Button1_Click" />
                        <ui:Button x:Name="Button8" Content="另存 PDF" Style="{StaticResource ToolbarPrimaryButtonStyle}" Click="Button8_Click" />
                        <ui:Button x:Name="Button4" Content="旋转视图" Style="{StaticResource ToolbarWideButtonStyle}" Click="Button4_Click" />
                        <ui:Button x:Name="Button5" Content="ISO" Style="{StaticResource ToolbarButtonStyle}" Click="Button5_Click" />
                        <ui:Button x:Name="Button14" Content="图纸设置" Style="{StaticResource ToolbarWideButtonStyle}" Click="Button14_Click_1" />
                    </StackPanel>

                    <StackPanel x:Name="AssemblyActionsPanel"
                                Orientation="Horizontal"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:Button x:Name="Button18" Content="编码整理" Style="{StaticResource ToolbarPrimaryButtonStyle}" Click="Button18_Click" />
                        <ui:Button x:Name="Button13" Content="排序" Style="{StaticResource ToolbarButtonStyle}" Click="Button13_Click" />
                        <ui:Button x:Name="Button11" Content="树设置" Style="{StaticResource ToolbarButtonStyle}" Click="Button11_Click" />
                        <ui:Button x:Name="Button6" Content="删自定义" Style="{StaticResource ToolbarDangerButtonStyle}" Click="Button6_Click_1" />
                        <ui:Button x:Name="Button17" Content="删配置" Style="{StaticResource ToolbarDangerButtonStyle}" Click="Button17_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</ui:FluentWindow>
