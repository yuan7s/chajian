<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <PlatformTarget>x64</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
        <AssemblyName>ExternalProgram.SwAddin.Runtime</AssemblyName>
        <RootNamespace>ExternalProgram.SwAddin</RootNamespace>
        <SwAddinRuntimePackageDirectory>$(MSBuildThisFileDirectory)..\ExternalProgram.SwAddin\bin\$(Configuration)\net48\Runtime\current\</SwAddinRuntimePackageDirectory>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Interop.SldWorks">
            <HintPath>..\lib\Interop.SldWorks.dll</HintPath>
            <EmbedInteropTypes>False</EmbedInteropTypes>
        </Reference>
        <Reference Include="Interop.SwConst">
            <HintPath>..\lib\Interop.SwConst.dll</HintPath>
            <EmbedInteropTypes>False</EmbedInteropTypes>
        </Reference>
        <Reference Include="SolidWorks.Interop.swpublished">
            <HintPath>..\lib\SolidWorks.Interop.swpublished.dll</HintPath>
            <EmbedInteropTypes>False</EmbedInteropTypes>
        </Reference>
        <Reference Include="SolidWorks.Interop.swdocumentmgr">
            <HintPath>..\lib\SolidWorks\SolidWorks.Interop.swdocumentmgr.dll</HintPath>
            <EmbedInteropTypes>False</EmbedInteropTypes>
        </Reference>
        <Reference Include="SolidWorksTools">
            <HintPath>..\lib\SolidWorksTools.dll</HintPath>
        </Reference>
        <Reference Include="Microsoft.CSharp" />
        <Reference Include="System.Net.Http" />
        <Reference Include="System.Web.Extensions" />
        <Reference Include="System.Windows.Forms" />
    </ItemGroup>

    <Target Name="CopyRuntimeToSwAddinPackage" AfterTargets="Build">
        <ItemGroup>
            <RuntimePackageFile Include="$(TargetDir)*.dll;$(TargetDir)*.pdb;$(TargetDir)*.xml;$(TargetDir)*.config" />
            <RuntimePackageFile Include="$(MSBuildThisFileDirectory)..\ExternalProgram.SwAddin\bin\$(Configuration)\net48\ExternalProgram.SwAddin.dll"
                                Condition="Exists('$(MSBuildThisFileDirectory)..\ExternalProgram.SwAddin\bin\$(Configuration)\net48\ExternalProgram.SwAddin.dll')" />
            <RuntimePackageFile Include="C:\Program Files\SOLIDWORKS\AnnotationWPF.dll"
                                Condition="Exists('C:\Program Files\SOLIDWORKS\AnnotationWPF.dll')" />
            <RuntimePackageFile Include="C:\Program Files\SOLIDWORKS\DveSupport.dll"
                                Condition="Exists('C:\Program Files\SOLIDWORKS\DveSupport.dll')" />
            <RuntimePackageFile Include="C:\Program Files\SOLIDWORKS\UiBase.dll"
                                Condition="Exists('C:\Program Files\SOLIDWORKS\UiBase.dll')" />
            <RuntimePackageFile Include="C:\Program Files\SOLIDWORKS\CoreInterface.dll"
                                Condition="Exists('C:\Program Files\SOLIDWORKS\CoreInterface.dll')" />
            <RuntimePackageFile Include="C:\Program Files\SOLIDWORKS\CmdInterface.dll"
                                Condition="Exists('C:\Program Files\SOLIDWORKS\CmdInterface.dll')" />
            <RuntimePackageFile Include="C:\Program Files\SOLIDWORKS\WPFRes.dll"
                                Condition="Exists('C:\Program Files\SOLIDWORKS\WPFRes.dll')" />
            <RuntimePackageFile Include="C:\Program Files\SOLIDWORKS\couplingBase.dll"
                                Condition="Exists('C:\Program Files\SOLIDWORKS\couplingBase.dll')" />
            <RuntimePackageFile Include="C:\Program Files\SOLIDWORKS\Controls.dll"
                                Condition="Exists('C:\Program Files\SOLIDWORKS\Controls.dll')" />
        </ItemGroup>
        <MakeDir Directories="$(SwAddinRuntimePackageDirectory)" />
        <Copy SourceFiles="@(RuntimePackageFile)"
              DestinationFolder="$(SwAddinRuntimePackageDirectory)"
              SkipUnchangedFiles="false"
              Retries="3"
              RetryDelayMilliseconds="300"
              Condition="'@(RuntimePackageFile)' != ''" />
    </Target>

</Project>
