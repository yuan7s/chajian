<ui:FluentWindow x:Class="外部程序.PropertyOverlaySettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="配置属性设置"
                 Width="370"
                 Height="560"
                 MinWidth="350"
                 MinHeight="500"
                 MaxHeight="620"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Microsoft YaHei UI"
                 FontSize="13"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PanelBrush" Color="#FCFCFD" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE3EA" />

            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>

            <Style x:Key="ActionButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="MinWidth" Value="68" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="DangerActionButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="Foreground" Value="#B42318" />
                <Setter Property="PressedForeground" Value="#B42318" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="配置属性设置"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="控制悬浮属性窗的显示内容和交互方式。"
                       Margin="0,4,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="14,12"
                Margin="0,0,0,12"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <TextBlock x:Name="OpacityLabel" Style="{StaticResource LabelStyle}" />
                <Slider x:Name="OpacitySlider"
                        Minimum="15"
                        Maximum="100"
                        TickFrequency="5"
                        Margin="0,0,0,14"
                        ValueChanged="OpacitySlider_ValueChanged" />

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="颜色方案" Style="{StaticResource LabelStyle}" />
                        <ComboBox x:Name="ColorCombo"
                                  Height="32"
                                  SelectionChanged="Combo_SelectionChanged">
                            <ComboBoxItem Content="自适应" />
                            <ComboBoxItem Content="终端绿" />
                            <ComboBoxItem Content="白字" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="显示范围" Style="{StaticResource LabelStyle}" />
                        <ComboBox x:Name="DisplayModeCombo"
                                  Height="32"
                                  SelectionChanged="Combo_SelectionChanged">
                            <ComboBoxItem Content="关键属性" />
                            <ComboBoxItem Content="全部属性" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="属性来源" Style="{StaticResource LabelStyle}" />
                        <ComboBox x:Name="PropSourceCombo"
                                  Height="32"
                                  SelectionChanged="Combo_SelectionChanged">
                            <ComboBoxItem Content="配置属性" />
                            <ComboBoxItem Content="自定义属性" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <CheckBox x:Name="TopMostCheck"
                                  Content="始终置顶"
                                  Margin="0,0,0,8"
                                  Checked="CheckBox_Changed"
                                  Unchecked="CheckBox_Changed" />
                        <CheckBox x:Name="MouseThroughCheck"
                                  Content="鼠标穿透"
                                  Checked="CheckBox_Changed"
                                  Unchecked="CheckBox_Changed" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Padding="14,12"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="2"
                           Text="关键属性"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,10" />

                <ListBox x:Name="KeyList"
                         Grid.Row="1"
                         Grid.Column="0"
                         BorderThickness="1"
                         BorderBrush="{StaticResource PanelBorderBrush}"
                         Background="White" />

                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                    <ui:Button Content="上移"
                               Width="42"
                               Height="42"
                               Padding="0"
                               ToolTip="上移"
                               Appearance="Secondary"
                               Click="UpButton_Click" />
                    <ui:Button Content="下移"
                               Width="42"
                               Height="42"
                               Padding="0"
                               ToolTip="下移"
                               Appearance="Secondary"
                               Margin="0,8,0,0"
                               Click="DownButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBox x:Name="NewKeyText"
                     Height="32"
                     Margin="0,0,0,8"
                     VerticalContentAlignment="Center" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button Content="添加"
                               Style="{StaticResource ActionButtonStyle}"
                               FontWeight="SemiBold"
                               Click="AddButton_Click" />
                    <ui:Button Content="删除"
                               Style="{StaticResource DangerActionButtonStyle}"
                               Margin="8,0,0,0"
                               Click="DeleteButton_Click" />
                </StackPanel>

                <ui:Button Grid.Column="2"
                           Content="关闭"
                           Style="{StaticResource ActionButtonStyle}"
                           Click="CloseButton_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

