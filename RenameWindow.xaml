<Window x:Class="RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名"
        MinWidth="720"
        MinHeight="330"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="White"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Width="740" Height="336">
        <Grid.RowDefinitions>
            <RowDefinition Height="5" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="20,12,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="142" />
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="254" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Header="文件命名" Foreground="#2D3748">
                <Grid Margin="16,8,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="126" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="旧名称" VerticalAlignment="Center" FontSize="16" />
                    <TextBox x:Name="OldNameBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" Background="#F8FAFC" />
                    <TextBlock x:Name="OldExtText" Grid.Row="0" Grid.Column="2" Text=".sldprt" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#606C7D" />
                    <Border x:Name="DrawingStatusBorder" Grid.Row="0" Grid.Column="3" CornerRadius="3" Background="#32CD32" Margin="8,5,0,5">
                        <TextBlock x:Name="DrawingStatusText" Text="存在工程图" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="新名称" VerticalAlignment="Center" FontSize="16" />
                    <TextBox x:Name="NewNameBox" Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="NewNameBox_TextChanged" />
                    <TextBlock x:Name="NewExtText" Grid.Row="2" Grid.Column="2" Text=".sldprt" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#606C7D" />
                    <Border x:Name="NameStatusBorder" Grid.Row="2" Grid.Column="3" CornerRadius="3" Background="#F3F4F6" Margin="8,5,0,5" Visibility="Collapsed">
                        <TextBlock x:Name="NameStatusText" Text="可保存" Foreground="Green" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Grid.Column="0" Header="写入属性" Foreground="#2D3748" Margin="0,12,0,10">
                <Grid Margin="27,0,18,0" Height="105">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="FileNameCheck" Grid.Row="0" Grid.Column="0" Content="文件名称" IsChecked="True" VerticalAlignment="Center" />
                    <CheckBox x:Name="MaterialCodeCheck" Grid.Row="0" Grid.Column="2" Content="物料编码" IsChecked="True" VerticalAlignment="Center" />
                    <CheckBox x:Name="PartNumberCheck" Grid.Row="0" Grid.Column="3" Content="零件图号" IsChecked="True" VerticalAlignment="Center" />

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <CheckBox x:Name="VersionCheck" Content="版本" VerticalAlignment="Center" />
                        <TextBox x:Name="VersionBox"
                                 Width="42"
                                 Height="24"
                                 Margin="8,0,0,0"
                                 Text="A"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <CheckBox x:Name="DesignCheck" Content="设计/出图" VerticalAlignment="Center" />
                        <TextBox x:Name="DesignBox"
                                 Width="80"
                                 Height="24"
                                 Margin="25,0,0,0"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <CheckBox x:Name="RenameDrawingCheck" Content="带图改名" IsChecked="True" Margin="0,0,24,0" />
                        <CheckBox x:Name="BlankSizeCheck" Content="下料尺寸" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,0">
                <Button Content="重命名"
                        Width="140"
                        Height="45"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8"
                        Click="RenameButton_Click" />
                <Button Content="另存"
                        Width="140"
                        Height="42"
                        Margin="0,0,0,8"
                        Click="SaveAsButton_Click" RenderTransformOrigin="0.501,1.008" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
