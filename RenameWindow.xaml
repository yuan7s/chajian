<Window x:Class="ExternalProgram.RenameWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="重命名"
                 Width="760"
                 Height="260"
                 MinWidth="720"
                 MinHeight="260"
                 MaxHeight="370"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 Topmost="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Microsoft YaHei UI"
                 FontSize="13"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PanelBrush" Color="#FCFCFD" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE3EA" />
            <SolidColorBrush x:Key="ReadOnlyBoxBrush" Color="#F4F7FA" />

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ActionButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="Width" Value="118" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="EmphasisActionButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="Height" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="132" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Row="1" Grid.Column="0" Text="旧名称" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="OldNameBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Background="{StaticResource ReadOnlyBoxBrush}" />
                    <TextBlock x:Name="OldExtText"
                               Grid.Row="1"
                               Grid.Column="2"
                               Text=".sldprt"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border x:Name="DrawingStatusBorder"
                            Grid.Row="1"
                            Grid.Column="3"
                            CornerRadius="7"
                            Background="#32CD32"
                            Margin="8,4,0,4">
                        <TextBlock x:Name="DrawingStatusText"
                                   Text="存在工程图"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="新名称" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="NewNameBox"
                             Grid.Row="3"
                             Grid.Column="1"
                             VerticalContentAlignment="Center"
                             TextChanged="NewNameBox_TextChanged" />
                    <TextBlock x:Name="NewExtText"
                               Grid.Row="3"
                               Grid.Column="2"
                               Text=".sldprt"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border x:Name="NameStatusBorder"
                            Grid.Row="3"
                            Grid.Column="3"
                            CornerRadius="7"
                            Background="#F3F4F6"
                            Margin="8,4,0,4"
                            Visibility="Collapsed">
                        <TextBlock x:Name="NameStatusText"
                                   Text="可保存"
                                   Foreground="Green"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <ui:Button Content="另存打开"
                           Style="{StaticResource ActionButtonStyle}"
                           Margin="0,0,8,0"
                           Click="SaveAsButton_Click" />
                <ui:Button Content="另存替换"
                           Style="{StaticResource ActionButtonStyle}"
                           Margin="0,0,8,0"
                           Click="SaveAsReplaceButton_Click" />
                <ui:Button Content="重命名"
                           Style="{StaticResource EmphasisActionButtonStyle}"
                           Click="RenameButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
