<ui:FluentWindow x:Class="外部程序.RenameWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="重命名"
                 Width="760"
                 Height="300"
                 MinWidth="720"
                 MinHeight="300"
                 MaxHeight="370"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Topmost="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Microsoft YaHei UI"
                 FontSize="13"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PanelBrush" Color="#FCFCFD" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE3EA" />
            <SolidColorBrush x:Key="ReadOnlyBoxBrush" Color="#F4F7FA" />

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ActionButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="Width" Value="118" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="EmphasisActionButtonStyle"
                   TargetType="{x:Type ui:Button}"
                   BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="Height" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="132" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="148" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Row="1" Grid.Column="0" Text="旧名称" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="OldNameBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Background="{StaticResource ReadOnlyBoxBrush}" />
                    <TextBlock x:Name="OldExtText"
                               Grid.Row="1"
                               Grid.Column="2"
                               Text=".sldprt"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border x:Name="DrawingStatusBorder"
                            Grid.Row="1"
                            Grid.Column="3"
                            CornerRadius="7"
                            Background="#32CD32"
                            Margin="8,4,0,4">
                        <TextBlock x:Name="DrawingStatusText"
                                   Text="存在工程图"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="新名称" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="NewNameBox"
                             Grid.Row="3"
                             Grid.Column="1"
                             VerticalContentAlignment="Center"
                             TextChanged="NewNameBox_TextChanged" />
                    <TextBlock x:Name="NewExtText"
                               Grid.Row="3"
                               Grid.Column="2"
                               Text=".sldprt"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border x:Name="NameStatusBorder"
                            Grid.Row="3"
                            Grid.Column="3"
                            CornerRadius="7"
                            Background="#F3F4F6"
                            Margin="8,4,0,4"
                            Visibility="Collapsed">
                        <TextBlock x:Name="NameStatusText"
                                   Text="可保存"
                                   Foreground="Green"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10,6" Margin="0,6,0,0" VerticalAlignment="Top">
                <Grid Height="100">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>
                     
                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <CheckBox x:Name="FileNameCheck" Content="文件名称" IsChecked="True" FontSize="11" Height="33" MinHeight="18" Margin="0,0,0,2" />
                        <CheckBox x:Name="MaterialCodeCheck" Content="物料编码" IsChecked="True" FontSize="11" Height="33" MinHeight="18" Margin="0,0,0,2" />
                        <CheckBox x:Name="PartNumberCheck" Content="零件图号" IsChecked="True" FontSize="11" Height="33" MinHeight="18" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0">
                        <CheckBox x:Name="RenameDrawingCheck" Content="带图改名" IsChecked="True" FontSize="11" Height="33" MinHeight="18" Margin="0,0,0,2" />
                        <CheckBox x:Name="BlankSizeCheck" Content="下料尺寸" FontSize="11" Height="33" MinHeight="25" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <CheckBox x:Name="DesignCheck" Content="设计出图" FontSize="11" Height="33" MinHeight="25" VerticalAlignment="Center" />
                            <TextBox x:Name="DesignBox"
                                     Width="80"
                                     Height="22"
                                     Margin="6,0,0,0"
                                     FontSize="11"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="VersionCheck" Content="版本" FontSize="11" Height="33" MinHeight="25" VerticalAlignment="Center" />
                            <TextBox x:Name="VersionBox"
                                     Width="44"
                                     Height="22"
                                     Margin="6,0,0,0"
                                     FontSize="11"
                                     Text="A"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,6,0,0" VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Center">
                    <ui:Button Content="重命名"
                               Style="{StaticResource EmphasisActionButtonStyle}"
                               Margin="0,0,0,6"
                               Click="RenameButton_Click" />
                    <ui:Button Content="另存"
                               Style="{StaticResource ActionButtonStyle}"
                               Click="SaveAsButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
