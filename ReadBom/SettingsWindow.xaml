<Window x:Class="ReadBom.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="720"
        Height="620"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SectionDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="DimGray"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinWidth" Value="96"/>
        </Style>
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="88"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="读取设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <GroupBox Header="默认获取位置" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionDescriptionStyle}">
                                    控制新增属性列默认使用 SolidWorks 的自定义属性还是当前配置属性。每个属性列仍可在“属性列”页单独选择获取位置。
                                </TextBlock>
                                <RadioButton Name="CustomSourceRadioButton"
                                             Margin="0,0,0,8"
                                             Content="从自定义属性读取"/>
                                <RadioButton Name="CurrentConfigurationSourceRadioButton"
                                             Content="从当前配置属性读取"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="读取条件" Padding="12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionDescriptionStyle}">
                                    控制 BOM 遍历时是否跳过虚拟件，以及同一文件在不同配置下是否分开统计。
                                </TextBlock>
                                <CheckBox Name="SkipVirtualCheckBox"
                                          Margin="0,0,0,8"
                                          Content="不读取虚拟件"/>
                                <CheckBox Name="GroupByConfigCheckBox"
                                          Content="按配置分组"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="属性列">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionDescriptionStyle}">
                        内置属性固定用于 BOM 读取，不能编辑。用户属性会作为动态属性列读取、显示和保存。
                    </TextBlock>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="96"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Name="PropertyGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="All"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  CellEditEnding="PropertyGrid_OnCellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="属性名"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Background" Value="#FFF0F0F0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="90" IsReadOnly="True"/>
                                <DataGridComboBoxColumn x:Name="SourceModeColumn"
                                                        Header="获取位置"
                                                        SelectedValueBinding="{Binding SourceMode, UpdateSourceTrigger=PropertyChanged}"
                                                        SelectedValuePath="Mode"
                                                        DisplayMemberPath="DisplayName"
                                                        Width="110">
                                    <DataGridComboBoxColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Background" Value="#FFF0F0F0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridComboBoxColumn.CellStyle>
                                </DataGridComboBoxColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Top">
                            <Button Height="32" Margin="0,0,0,8" Click="AddButton_OnClick">新增</Button>
                            <Button Height="32" Margin="0,0,0,8" Click="DeleteButton_OnClick">删除</Button>
                            <Button Height="32" Margin="0,0,0,8" Click="MoveUpButton_OnClick">上移</Button>
                            <Button Height="32" Margin="0,0,0,8" Click="MoveDownButton_OnClick">下移</Button>
                            <Button Height="32" Click="ResetPropertiesButton_OnClick">恢复默认</Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="筛选设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <GroupBox Header="去除组件装配" Padding="12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionDescriptionStyle}">
                                    这里配置主界面“去除组件装配”按钮的筛选条件。启用按钮后，满足以下条件的行会被隐藏。
                                </TextBlock>

                                <CheckBox Name="ExcludeMainAssemblyCheckBox"
                                          Margin="0,0,0,12"
                                          Content="同时去除 BOM 第一行主装配体"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingLabelStyle}">文档类型 等于</TextBlock>
                                    <TextBox Grid.Column="1"
                                             Name="AssemblyDocumentTypeTextBox"
                                             MinHeight="34"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingLabelStyle}">零件类型(当前配置) 等于</TextBlock>
                                    <TextBox Grid.Column="1"
                                             Name="AssemblyPartTypeTextBox"
                                             MinHeight="34"/>
                                </Grid>

                                <Button Width="112"
                                        Height="32"
                                        HorizontalAlignment="Left"
                                        Click="ResetFilterButton_OnClick">恢复默认条件</Button>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1"
                   Name="ValidationText"
                   Margin="0,8,0,0"
                   Foreground="Firebrick"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Style="{StaticResource SettingsButtonStyle}"
                    IsDefault="True"
                    Click="SaveButton_OnClick">保存</Button>
            <Button Style="{StaticResource SettingsButtonStyle}"
                    IsCancel="True">取消</Button>
        </StackPanel>
    </Grid>
</Window>
