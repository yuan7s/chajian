<Window x:Class="ReadBom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReadBom"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="SW Properties/BOM Tool"
        Icon="Assets/app.ico"
        Height="720"
        Width="1200"
        MinHeight="640"
        MinWidth="980"
        WindowState="Maximized"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="ReadBomSurfaceBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ReadBomSubtleSurfaceBrush" Color="#FFF7F8FA"/>
        <SolidColorBrush x:Key="ReadBomBorderBrush" Color="#FFE3E6EA"/>
        <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">26</sys:Double>
        <Style x:Key="BomGridHorizontalScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Height" Value="14"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Height="{TemplateBinding Height}"
                                MinWidth="{TemplateBinding MinWidth}"
                                CornerRadius="10"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1"
                                Background="#FF8A94A3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FF667085"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FF475467"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BomGridScrollBarRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="MinHeight" Value="26"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Height="{TemplateBinding Height}"
                                      MinHeight="{TemplateBinding MinHeight}"
                                      Background="Transparent"
                                      SnapsToDevicePixels="True">
                                    <Border Height="16"
                                            Margin="4,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="11"
                                            Background="#FFE8EBEF"/>
                                    <Track x:Name="PART_Track"
                                           Height="18"
                                           Margin="8,0"
                                           VerticalAlignment="Center"
                                           IsDirectionReversed="False"
                                           Maximum="{TemplateBinding Maximum}"
                                           Minimum="{TemplateBinding Minimum}"
                                           Orientation="{TemplateBinding Orientation}"
                                           Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                           ViewportSize="{TemplateBinding ViewportSize}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                          Style="{StaticResource BomGridScrollBarRepeatButtonStyle}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource BomGridHorizontalScrollBarThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                          Style="{StaticResource BomGridScrollBarRepeatButtonStyle}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolbarWideButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="88"/>
        </Style>
        <Style x:Key="ToolbarOptionTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="ToolbarGroupTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="ToolbarGroupBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource ReadBomBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>
        <Style x:Key="FlatLogToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{StaticResource ReadBomSubtleSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ReadBomBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12" Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="LogAreaRow" Height="120"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource ReadBomBorderBrush}"
                BorderThickness="1"
                Background="{StaticResource ReadBomSurfaceBrush}"
                CornerRadius="8"
                Padding="10,10,10,4">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Name="StatusText"
                           Width="180"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource ToolbarGroupBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ToolbarGroupTitleStyle}">连接读取</TextBlock>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0">
                                    <Button Name="ConnectButton" Style="{StaticResource ToolbarWideButtonStyle}" Click="ConnectButton_OnClick">连接 SW ▾</Button>
                                    <Button Name="ReadButton" Style="{StaticResource ToolbarWideButtonStyle}" Click="ReadButton_OnClick">读取 BOM</Button>
                                    <Button Name="SaveToSwButton" Style="{StaticResource ToolbarWideButtonStyle}" Click="SaveToSwButton_OnClick">保存到 SW</Button>
                                </WrapPanel>
                                <WrapPanel Grid.Row="1">
                                    <Button Name="OpenOfflineFileButton" Style="{StaticResource ToolbarWideButtonStyle}" Visibility="Collapsed" Click="OpenOfflineFileButton_OnClick">打开本地文件</Button>
                                    <Button Name="SettingsButton" Style="{StaticResource ToolbarButtonStyle}" Click="SettingsButton_OnClick">设置</Button>
                                    <TextBlock Name="SettingsSummaryText"
                                               Style="{StaticResource ToolbarOptionTextStyle}"
                                               Margin="4,0,0,2"/>
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolbarGroupBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ToolbarGroupTitleStyle}">写入处理</TextBlock>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0">
                                    <Button Name="RelocateFilesButton" Style="{StaticResource ToolbarWideButtonStyle}" Click="RelocateFilesButton_OnClick">复制重装</Button>
                                    <Button Name="CalculateBlankSizeButton" Style="{StaticResource ToolbarWideButtonStyle}" Click="CalculateBlankSizeButton_OnClick">计算下料</Button>
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolbarGroupBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ToolbarGroupTitleStyle}">显示导出</TextBlock>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0">
                                    <Button Name="ExportCsvButton" Style="{StaticResource ToolbarButtonStyle}" Click="ExportCsvButton_OnClick">导出 CSV</Button>
                                    <Button Name="ExportExcelButton" Style="{StaticResource ToolbarWideButtonStyle}" Click="ExportExcelButton_OnClick">导出 Excel</Button>
                                </WrapPanel>
                                <WrapPanel Grid.Row="1">
                                    <Button Name="ThumbnailButton" Style="{StaticResource ToolbarButtonStyle}" Click="ThumbnailButton_OnClick">缩略图开</Button>
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolbarGroupBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ToolbarGroupTitleStyle}">表格操作</TextBlock>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0">
                                    <Button Name="HeaderFilterButton" Style="{StaticResource ToolbarButtonStyle}" Click="HeaderFilterButton_OnClick">表头筛选</Button>
                                    <Button Name="ExcludeStandardPartsButton" Style="{StaticResource ToolbarWideButtonStyle}" Click="ExcludeStandardPartsButton_OnClick">排除标准件</Button>
                                    <Button Name="ExcludeAssemblyComponentsButton" Style="{StaticResource ToolbarWideButtonStyle}" Click="ExcludeAssemblyComponentsButton_OnClick">去除组件装配</Button>
                                </WrapPanel>
                                <WrapPanel Grid.Row="1">
                                    <Button Name="CopyColumnButton" Style="{StaticResource ToolbarButtonStyle}" Click="CopyColumnButton_OnClick">复制列</Button>
                                    <Button Name="FillColumnButton" Style="{StaticResource ToolbarButtonStyle}" Click="FillColumnButton_OnClick">填充列</Button>
                                    <Button Name="FindReplaceButton" Style="{StaticResource ToolbarWideButtonStyle}" Click="FindReplaceButton_OnClick">查找替换</Button>
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="ProgressText"
                       VerticalAlignment="Center"
                       TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">就绪</TextBlock>
            <ProgressBar Grid.Column="1" Name="ReadProgressBar" Height="16" Minimum="0" Maximum="100" Value="0"/>
        </Grid>

        <DataGrid Grid.Row="1"
                  Name="BomGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  Margin="0"
                  RowHeight="28"
                  FontSize="12"
                  Tag="20"
                  Background="{StaticResource ReadBomSurfaceBrush}"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  BorderBrush="{StaticResource ReadBomBorderBrush}"
                  BorderThickness="1"
                  RowBackground="{StaticResource ReadBomSurfaceBrush}"
                  AlternatingRowBackground="{StaticResource ReadBomSubtleSurfaceBrush}"
                  RowHeaderWidth="0"
                  SelectionMode="Extended"
                  SelectionUnit="Cell"
                  ClipboardCopyMode="None"
                  FrozenColumnCount="4"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{StaticResource ReadBomBorderBrush}"
                  VerticalGridLinesBrush="{StaticResource ReadBomBorderBrush}"
                  HeadersVisibility="All"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  VirtualizingPanel.CacheLength="1"
                  VirtualizingPanel.CacheLengthUnit="Page"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.IsDeferredScrollingEnabled="True"
                  CanUserResizeRows="False"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="False"
                  BeginningEdit="BomGrid_OnBeginningEdit"
                  PreviewMouseLeftButtonUp="BomGrid_OnPreviewMouseLeftButtonUp"
                  PreviewMouseRightButtonDown="BomGrid_OnPreviewMouseRightButtonDown"
                  PreviewKeyDown="BomGrid_OnPreviewKeyDown"
                  CellEditEnding="BomGrid_OnCellEditEnding"
                  SelectedCellsChanged="BomGrid_OnSelectedCellsChanged"
                  CurrentCellChanged="BomGrid_OnCurrentCellChanged">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="复制" Click="CopyCellsMenuItem_OnClick"/>
                    <MenuItem Header="粘贴" Click="PasteCellsMenuItem_OnClick"/>
                    <Separator/>
                    <MenuItem Header="复制列" Click="CopyColumnButton_OnClick"/>
                    <MenuItem Header="填充列" Click="FillColumnButton_OnClick"/>
                    <MenuItem Header="查找替换" Click="FindReplaceButton_OnClick"/>
                    <Separator/>
                    <MenuItem Header="打开模型" Click="OpenModelMenuItem_OnClick"/>
                    <MenuItem Header="打开工程图" Click="OpenDrawingMenuItem_OnClick"/>
                    <Separator/>
                    <MenuItem Name="SaveContextMenuItem" Header="保存到 SW" Click="SaveToSwButton_OnClick"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="4,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelectionRow}" Value="True">
                            <Setter Property="Background" Value="#FFE8F2FF"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="MinHeight" Value="30"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="6,0"/>
                    <Setter Property="Background" Value="{StaticResource ReadBomSubtleSurfaceBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ReadBomBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="类型" Width="56">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate d:DataContext="{d:DesignInstance local:BomRow}">
                            <Image Source="{Binding DocumentIconPath}"
                                   ToolTip="{Binding DocumentType}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                   Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="工程图" Width="64">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate d:DataContext="{d:DesignInstance local:BomRow}">
                            <Image Source="{Binding DrawingIconPath}"
                                   ToolTip="{Binding DrawingStatus}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                   Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="48" CanUserSort="False">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="文件名称" Binding="{Binding FileName}" Width="220"/>
                <DataGridTextColumn Header="配置" Binding="{Binding Configuration}" Width="70"/>
                <DataGridTextColumn Header="文件夹名称" Binding="{Binding FolderName}" Width="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="50">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="SW材料" Binding="{Binding Material}" Width="120">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnsetMaterial}" Value="True">
                                    <Setter Property="Background" Value="#FFFFD6D6"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                BorderBrush="{StaticResource ReadBomBorderBrush}"
                BorderThickness="1"
                Background="{StaticResource ReadBomSurfaceBrush}"
                CornerRadius="8"
                Padding="8,4,8,8"
                Margin="0,6,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Name="ToggleLogButton"
                    Style="{StaticResource FlatLogToggleButtonStyle}"
                    Click="ToggleLogButton_OnClick">日志-</Button>
            <RichTextBox Grid.Row="1"
                         Name="LogTextBox"
                         Margin="0,6,0,0"
                         BorderThickness="0"
                         Background="{StaticResource ReadBomSurfaceBrush}"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"/>
        </Grid>
        </Border>
    </Grid>
</Window>

